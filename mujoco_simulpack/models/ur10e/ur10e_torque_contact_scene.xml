<mujoco model="ur10e contact scene">
  <include file="ur10e_torque.xml"/>

  <statistic center="0.35 0 0.45" extent="1.3"/>

  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  
  <!-- 렌더/조명/환경 설정 -->
  <visual> 
    <scale framelength="0.2" framewidth="0.02"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <!-- 장면을 둘러싼 배경의 텍스쳐/머터리얼 자원 -->
  <asset>
    <!-- 하늘 배경 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <!-- 바닥용 격자 텍스처 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <!-- 바닥 머터리얼 -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <!-- 접촉 박스 (시각 표시)에 쓸 빨간 머터리얼 -->
    <material name="contact_red" rgba="0.8 0.15 0.1 1"/>
    <material name="contact_amber" rgba="0.95 0.55 0.12 1"/>
    <mesh name="contact_hemisphere_mesh" file="contact_hemisphere.obj"/>
  </asset>

  <!-- 장면의 물리적 객체들 -->
  <worldbody>
    <!-- 장면 광원 -->
    <light pos="0 0 1.8" dir="0 0 -1" directional="true"/>

    <!-- 바닥 geometry -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 접촉 박스 -->
    <body name="contact_box" pos="0.5 0.0 0.38"> 
      <!-- 접촉 박스 geometry -->
      <geom name="contact_box_geom" type="box" size="0.08 0.08 0.08" material="contact_red"
            condim="4" friction="1.0 0.1 0.001"
            solimp="0.9 0.95 0.001" solref="0.02 1"/>
      <!-- condim: 접촉 제약 차원 (4: 1개의 Normal + 3개의 Tangent 제약) -->
      <!-- friction="sliding, tortional(0.2*sliding), rolling(0.01*sliding)" -->
      <!-- solimp/solref: soft constraint/contact solver 파라미터 -->
      <!-- material="contact_red": 위에서 정의한 빨간 머터리얼을 적용 -->
    </body>
    <!-- 160 mm diameter; 60 mm gap from box; apex level with box top. -->
    <body name="contact_hemisphere" pos="0.5 -0.22 0.38">
      <geom name="contact_hemisphere_geom" type="mesh" mesh="contact_hemisphere_mesh"
            material="contact_amber" condim="4" friction="1.0 0.1 0.001"/>
    </body>
  </worldbody>
</mujoco>
